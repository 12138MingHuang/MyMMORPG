<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<log4net>
		<logger name="Unity" additivity="false">
			<level value="ALL" />
			<appender-ref ref="UnityLog" />
		</logger>
		<appender name="UnityLog" type="log4net.Appender.RollingFileAppender">
			<!-- 设置日志文件的存放目录 -->
			<param name="File" value="D:\\MyUnityProject\\MyMMORPG\\Src\\Client\\Assets\\Log\\" />
			<!-- 设置为 true，表示日志追加到现有文件中 -->
			<param name="appendToFile" value="true" />
			<!-- 设置日志文件的滚动方式为按日期滚动 -->
			<param name="rollingStyle" value="Date" />
			<!-- 设置日志文件名的日期格式 -->
			<param name="datePattern" value="yyyyMMdd'.txt'" />
			<!-- 设置日志文件名不为静态 -->
			<param name="staticLogFileName" value="false" />
			<!-- 设置最大的备份日志文件的数量 -->
			<param name="maxSizeRollBackups" value="100" />
			<!-- 定义日志消息的布局格式 -->
			<layout type="log4net.Layout.PatternLayout">
				<!-- 设置日志消息的转换模式 -->
				<param name="conversionPattern" value="%newline%date [%thread] [%-5level] [%logger] ：%message" />
			</layout>
		</appender>
	</log4net>
</configuration>
