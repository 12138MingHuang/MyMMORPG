<log4net>
	<!-- 配置根日志记录器 -->
	<root>
		<!-- 
        设置日志级别为ALL
        ALL:
        记录所有日志消息，无论其严重性如何。
        用于启用所有日志记录，通常用于调试阶段。
        
        DEBUG:
        记录调试信息，通常用于开发和调试阶段，帮助开发人员诊断问题。
        包括更详细的应用程序运行信息。

        OFF:
        关闭日志记录。
        用于禁用日志输出。
		-->
		<level value="ALL" />
		<!-- 引用 LogFileAppender -->
		<appender-ref ref="LogFileAppender" />
		<!-- 引用 RollingLogFileAppender -->
		<appender-ref ref="RollingLogFileAppender" />
		<!-- 引用 ColoredConsoleAppender -->
		<appender-ref ref="ColoredConsoleAppender" />
	</root>

	<!-- 定义一个滚动文件附加器，按文件大小滚动 -->
	<appender name="LogFileAppender" type="log4net.Appender.RollingFileAppender">
		<!-- 设置日志文件路径 -->
		<param name="File" value="logs/cmm.log" />
		<!-- 设置为追加模式 -->
		<param name="AppendToFile" value="true" />
		<!-- 设置滚动风格为按大小滚动 -->
		<rollingStyle value="Size" />
		<!-- 设置最大备份文件数 -->
		<maxSizeRollBackups value="10" />
		<!-- 设置最大文件大小 -->
		<maximumFileSize value="1MB" />
		<!-- 设置静态日志文件名 -->
		<staticLogFileName value="true" />
		<!-- 配置日志输出格式 -->
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date [%02thread] %-5level %logger: %message%newline" />
			<!--<conversionPattern value="%date [%2thread] %-5level %logger (%location): %message%newline" />-->
		</layout>
		<!-- 设置日志文件编码为UTF-8 -->
		<encoding value="utf-8" />
	</appender>

	<!-- 定义一个滚动文件附加器，按日期滚动 -->
	<appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
		<!-- 设置日志文件目录 -->
		<file value="Log/" />
		<!-- 设置为追加模式 -->
		<appendToFile value="true" />
		<!-- 设置滚动风格为按日期滚动 -->
		<rollingStyle value="Date" />
		<!-- 设置日期模式的文件后缀 -->
		<datePattern value="yyyyMMdd'.log'" />
		<!-- 设置动态日志文件名 -->
		<staticLogFileName value="false" />
		<!-- 设置最大备份文件数 -->
		<param name="MaxSizeRollBackups" value="100" />
		<!-- 配置日志输出格式 -->
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%newline%date [%02thread] [%-5level] [%logger] ：%message" />
			<!--<conversionPattern value="%date [%2thread] %-5level %logger (%location): %message%newline" />-->
		</layout>
		<!-- 设置日志文件编码为UTF-8 -->
		<encoding value="utf-8" />
	</appender>

	<!-- 定义一个彩色控制台附加器 -->
	<appender name="ColoredConsoleAppender" type="log4net.Appender.ColoredConsoleAppender">
		<!-- 映射致命级别日志为白色背景红色字体 -->
		<mapping>
			<level value="FATAL" />
			<foreColor value="Red, HighIntensity" />
			<backColor value="White" />
		</mapping>
		<!-- 映射错误级别日志为高亮红色 -->
		<mapping>
			<level value="ERROR" />
			<foreColor value="Red, HighIntensity" />
		</mapping>
		<!-- 映射警告级别日志为高亮黄色 -->
		<mapping>
			<level value="WARN" />
			<foreColor value="Yellow, HighIntensity" />
		</mapping>
		<!-- 映射信息级别日志为白色 -->
		<mapping>
			<level value="INFO" />
			<foreColor value="White" />
		</mapping>
		<!-- 映射调试级别日志为高亮紫色 -->
		<mapping>
			<level value="DEBUG" />
			<foreColor value="Purple, HighIntensity" />
		</mapping>
		<!-- 映射跟踪级别日志为高亮蓝色 -->
		<mapping>
			<level value="TRACE" />
			<foreColor value="Blue, HighIntensity" />
		</mapping>
		<!-- 配置日志输出格式 -->
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date [%02thread] %-5level %logger: %message%newline" />
			<!--<conversionPattern value="%date [%2thread] %-5level %logger (%location): %message%newline" />-->
		</layout>
	</appender>

</log4net>
